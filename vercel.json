{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "useelos.com"
        }
      ],
      "destination": "/useelos/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.useelos.com"
        }
      ],
      "destination": "/useelos/index.html"
    },
    {
      "source": "/useelos",
      "destination": "/useelos/index.html"
    }
  ]
}
